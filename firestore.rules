rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hotel guest requests (accessible by guests scanning QR code and staff)
    match /requests/{requestId} {
      allow read, write: if true;
    }
    
    // Staff & Developer accounts directory
    match /accounts/{accountId} {
      allow read, write: if true;
    }

    // Room Occupancy & Checkout Stays
    match /room_stays/{roomNumber} {
      allow read, write: if true;
    }

    // Hotel Staff Roster & Associates (Admin-managed)
    match /staff_members/{staffId} {
      allow read, write: if true;
    }
  }
}
