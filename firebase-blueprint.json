{
  "entities": {
    "HotelRequest": {
      "title": "HotelRequest",
      "description": "Guest service and assistance requests submitted by hotel rooms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomNumber": { "type": "string" },
        "category": { "type": "string" },
        "additionalMessage": { "type": "string" },
        "status": { "type": "string", "enum": ["NEW", "IN_PROGRESS", "COMPLETED", "CANCELLED"] },
        "isEmergency": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "acceptedAt": { "type": "number" },
        "completedAt": { "type": "number" },
        "assignedStaffId": { "type": "string" },
        "assignedStaffName": { "type": "string" },
        "completedByStaffId": { "type": "string" },
        "completedByStaffName": { "type": "string" }
      },
      "required": ["id", "roomNumber", "category", "status", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Hotel staff and developer team profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["developer", "staff"] },
        "roleTitle": { "type": "string" },
        "department": { "type": "string" },
        "phone": { "type": "string" },
        "shift": { "type": "string" },
        "bio": { "type": "string" },
        "avatarColor": { "type": "string" },
        "isPrimaryDeveloper": { "type": "boolean" },
        "dutyStatus": { "type": "string", "enum": ["ON_DUTY", "ON_BREAK", "OFF_DUTY"] },
        "createdAt": { "type": "number" },
        "lastLoginAt": { "type": "number" }
      },
      "required": ["id", "username", "name", "role", "dutyStatus"]
    },
    "RoomStay": {
      "title": "RoomStay",
      "description": "Hotel room occupancy status, dynamic access passcodes, and specifications",
      "type": "object",
      "properties": {
        "roomNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["OCCUPIED", "CHECKED_OUT"] },
        "accessCode": { "type": "string" },
        "guestName": { "type": "string" },
        "floor": { "type": "number" },
        "roomType": { "type": "string" },
        "bedType": { "type": "string" },
        "checkInAt": { "type": "number" },
        "checkOutAt": { "type": "number" },
        "notes": { "type": "string" },
        "lastUpdated": { "type": "number" }
      },
      "required": ["roomNumber", "status"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Hotel operational staff roster for dispatch and task assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "roleTitle": { "type": "string" },
        "department": { "type": "string" },
        "phone": { "type": "string" },
        "shift": { "type": "string" },
        "dutyStatus": { "type": "string", "enum": ["ON_DUTY", "ON_BREAK", "OFF_DUTY"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" },
        "createdByAdmin": { "type": "string" }
      },
      "required": ["id", "name", "roleTitle", "department", "dutyStatus"]
    }
  },
  "firestore": {
    "/requests/{requestId}": {
      "schema": "HotelRequest",
      "description": "Collection of all guest assistance requests"
    },
    "/accounts/{accountId}": {
      "schema": "UserProfile",
      "description": "Collection of all staff and developer accounts"
    },
    "/room_stays/{roomNumber}": {
      "schema": "RoomStay",
      "description": "Collection of hotel room occupancy and dynamic access passcodes"
    },
    "/staff_members/{staffId}": {
      "schema": "StaffMember",
      "description": "Collection of hotel staff roster members for request assignments"
    }
  }
}
